<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true" android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#FFFFFF" />
                    <corners android:radius="12dp" />
                </shape>
            </item>
            <item
                android:left="10dp"
                android:top="10dp"
                android:right="10dp"
                android:bottom="10dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/accent_bright" />
                    <corners android:radius="7dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/accent" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/accent_bright" />
                    <corners android:radius="12dp" />
                </shape>
            </item>
            <item
                android:left="10dp"
                android:top="10dp"
                android:right="10dp"
                android:bottom="10dp">
                <shape android:shape="rectangle">
                    <solid android:color="#2B4B80" />
                    <corners android:radius="7dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/surface_hi" />
            <stroke
                android:width="1dp"
                android:color="#39424F" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>
