<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="#10161F" />
            <stroke
                android:width="1dp"
                android:color="#232B36" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/accent_bright" />
                    <corners android:radius="12dp" />
                </shape>
            </item>
            <item
                android:left="8dp"
                android:top="8dp"
                android:right="8dp"
                android:bottom="8dp">
                <shape android:shape="rectangle">
                    <solid android:color="#182338" />
                    <corners android:radius="8dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#10161F" />
            <stroke
                android:width="1dp"
                android:color="#39424F" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>
